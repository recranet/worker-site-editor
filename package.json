{
	"name": "@recranet/worker-site-editor",
	"version": "20261127.0.8",
	"description": "Text editing for Recranet's customer sites on Cloudflare Workers: sign-in through the console, the Portable Text editor at /admin/, texts in D1 and images in R2.",
	"license": "UNLICENSED",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/recranet/worker-site-editor.git"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./extensions": {
			"types": "./dist/extensions/index.d.ts",
			"default": "./dist/extensions/index.js"
		},
		"./admin": {
			"types": "./dist/client/index.d.ts",
			"default": "./dist/client/index.js"
		},
		"./admin.css": "./dist/client/admin.css",
		"./extensions/admin": {
			"types": "./dist/extensions/client/index.d.ts",
			"default": "./dist/extensions/client/index.js"
		}
	},
	"files": [
		"dist",
		"migrations"
	],
	"sideEffects": [
		"*.css"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.client.build.json && cp src/client/admin.css dist/client/admin.css",
		"check": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
		"test": "vitest run",
		"format": "prettier --write .",
		"prepack": "pnpm run build"
	},
	"peerDependencies": {
		"@base-ui/react": "^1.9.0",
		"@portabletext/editor": "^8.2.15",
		"hono": "^4.13.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"dependencies": {
		"@portabletext/to-html": "^6.0.0",
		"better-auth": "^1.7.27"
	},
	"devDependencies": {
		"@base-ui/react": "^1.9.0",
		"@cloudflare/workers-types": "^5.20261125.1",
		"@portabletext/editor": "^8.2.15",
		"@types/node": "^26.6.11",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"hono": "^4.13.21",
		"prettier": "^3.6.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": "^26.12.0"
	},
	"packageManager": "pnpm@12.18.0"
}
